---
import Layout from "./Layout.astro";
import { slugifyStr } from "@/utils/slugify";
import { seoSite, pageTitle } from "@/utils/seoSite";
import { blogPostingSchema, breadcrumbSchema } from "@/utils/seo";

type Props = {
  /** Post title, without the site suffix. */
  title: string;
  description: string;
  ogImage?: string;
  canonicalURL: string;
  pubDatetime: Date;
  /** Last git commit of the source note (falls back to pubDatetime). */
  lastModified?: Date;
  tags: string[];
  lang: string;
};

const {
  title,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  lastModified = pubDatetime,
  tags,
  lang,
} = Astro.props;

const jsonLd = [
  blogPostingSchema(seoSite, {
    title,
    description,
    url: canonicalURL,
    image: ogImage,
    datePublished: pubDatetime,
    dateModified: lastModified,
    tags,
    lang,
  }),
  breadcrumbSchema(seoSite, [
    { name: "Home", path: "" },
    ...tags.slice(0, 1).map(tag => ({ name: tag, path: `tags/${slugifyStr(tag)}/` })),
    { name: title, path: canonicalURL },
  ]),
];
---

<Layout
  title={pageTitle(title)}
  {description}
  {ogImage}
  ogImageAlt={title}
  {canonicalURL}
  {lang}
  ogType="article"
  {jsonLd}
>
  <Fragment slot="head">
    <meta
      property="article:published_time"
      content={pubDatetime.toISOString()}
    />
    <meta
      property="article:modified_time"
      content={lastModified.toISOString()}
    />
    {tags.map(tag => <meta property="article:tag" content={tag} />)}
  </Fragment>

  <slot />
</Layout>
