---
import Layout from "./Layout.astro";
import { getCategory } from "@/data/categories";
import { seoSite, pageTitle } from "@/utils/seoSite";
import { blogPostingSchema, breadcrumbSchema } from "@/utils/seo";

type Props = {
  /** Post title, without the site suffix. */
  title: string;
  description: string;
  ogImage?: string;
  canonicalURL: string;
  pubDatetime: Date;
  /** Last git commit of the source note (falls back to pubDatetime). */
  lastModified?: Date;
  /** Category slug (the note's til/ folder). */
  category: string;
  lang: string;
};

const {
  title,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  lastModified = pubDatetime,
  category: categorySlug,
  lang,
} = Astro.props;

const category = getCategory(categorySlug);

const jsonLd = [
  blogPostingSchema(seoSite, {
    title,
    description,
    url: canonicalURL,
    image: ogImage,
    datePublished: pubDatetime,
    dateModified: lastModified,
    tags: [category.label],
    lang,
  }),
  breadcrumbSchema(seoSite, [
    { name: "Home", path: "" },
    { name: category.label, path: `categories/${category.slug}/` },
    { name: title, path: canonicalURL },
  ]),
];
---

<Layout
  title={pageTitle(title)}
  {description}
  {ogImage}
  ogImageAlt={title}
  {canonicalURL}
  {lang}
  ogType="article"
  {jsonLd}
>
  <Fragment slot="head">
    <meta
      property="article:published_time"
      content={pubDatetime.toISOString()}
    />
    <meta
      property="article:modified_time"
      content={lastModified.toISOString()}
    />
    <meta property="article:section" content={category.label} />
    <meta property="article:tag" content={category.label} />
  </Fragment>

  <slot />
</Layout>
