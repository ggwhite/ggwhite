---
type Props = {
  /** Base-prefixed path of the page the stub sends visitors to. */
  target: string;
};

// A noindex stub that forwards old URLs (meta refresh + JS) and points
// search engines at the new page via its canonical. Callers keep these
// paths out of the sitemap (astro.config.ts); they carry no
// data-pagefind-body, so Pagefind skips them.
const { target } = Astro.props;
const canonical = new URL(target, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Redirecting…</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <script is:inline define:vars={{ target }}>
      location.replace(target);
    </script>
  </head>
  <body>
    <p>Moved to <a href={target}>{canonical}</a>.</p>
  </body>
</html>
