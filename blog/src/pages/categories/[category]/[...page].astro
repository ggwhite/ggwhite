---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import { countCategories, type Category } from "@/data/categories";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { postFilter } from "@/utils/postFilter";
import { useTranslations } from "@/i18n";
import { breadcrumbSchema } from "@/utils/seo";
import { seoSite, pageTitle, pageSuffix } from "@/utils/seoSite";
import config from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = (await getCollection("posts")).filter(postFilter);
  const categories = countCategories(posts.map(p => p.data.category));

  return categories.flatMap(category =>
    paginate(
      getSortedPosts(posts.filter(p => p.data.category === category.slug)),
      {
        params: { category: category.slug },
        props: { category },
        pageSize: config.posts.perPage,
      }
    )
  );
}

const { page } = Astro.props;
const category: Category = Astro.props.category;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const description =
  `${page.total} TIL ${page.total === 1 ? "post" : "posts"} in ${category.label} on White's Tech Notes` +
  (category.blurb
    ? `: ${category.blurb}`
    : ": real problems a backend engineer hit, with the root cause and the fix.") +
  (page.currentPage > 1
    ? ` Page ${page.currentPage} of ${page.lastPage}.`
    : "");
const jsonLd = [
  breadcrumbSchema(seoSite, [
    { name: "Home", path: "" },
    { name: t.pages.categoriesTitle, path: "categories/" },
    { name: category.label, path: `categories/${category.slug}/` },
  ]),
];
---

<Layout
  title={pageTitle(
    `${category.label} — ${t.pages.categoryTitle}${pageSuffix(page.currentPage)}`
  )}
  {description}
  {jsonLd}
>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={category.label}
    pageDesc={category.blurb || `${t.pages.categoryDesc} "${category.label}".`}
  >
    <ul>
      {page.data.map(data => <Card {...data} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
