---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { countCategories } from "@/data/categories";
import { postFilter } from "@/utils/postFilter";
import { useTranslations } from "@/i18n";
import { breadcrumbSchema } from "@/utils/seo";
import { seoSite, pageTitle } from "@/utils/seoSite";
import config from "@/config";

const posts = (await getCollection("posts")).filter(postFilter);
const categories = countCategories(posts.map(p => p.data.category));

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const description = `Browse ${posts.length} TIL posts by category: ${categories
  .slice(0, 4)
  .map(c => c.label)
  .join(", ")} and ${categories.length - 4} more topics in backend engineering.`;
const jsonLd = [
  breadcrumbSchema(seoSite, [
    { name: "Home", path: "" },
    { name: t.pages.categoriesTitle, path: "categories/" },
  ]),
];
---

<Layout title={pageTitle(t.pages.categoriesTitle)} {description} {jsonLd}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.categoriesTitle} pageDesc={t.pages.categoriesDesc}>
    <ul class="grid gap-4 sm:grid-cols-2">
      {
        categories.map(({ slug, label, blurb, blurbZh, count }) => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, `categories/${slug}/`)}
              class:list={[
                "border-border flex h-full flex-col gap-1 rounded-lg border p-4",
                "hover:border-accent focus-visible:border-accent group",
              ]}
            >
              <span class="flex items-baseline justify-between gap-2">
                <span class="text-accent text-lg font-medium decoration-dashed underline-offset-4 group-hover:underline">
                  {label}
                </span>
                <span class="text-muted-foreground text-sm tabular-nums">
                  {count} {count === 1 ? "post" : "posts"}
                </span>
              </span>
              {blurb && <span class="text-sm">{blurb}</span>}
              {blurbZh && (
                <span class="text-muted-foreground text-sm" lang="zh-Hant">
                  {blurbZh}
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
